<%- include('../head'); -%>
<main>
  <div class="jumbotron">
    <div class="d-flex justify-content-between align-items-center">
      <h1>Lyrics</h1>
      <a href="/lyrics/new" class="btn btn-primary mb-3"><i class="fa fa-plus"></i> Add New Lyric</a>
    </div>

    <% if (lyrics.length === 0) { %>
      <p class="mt-4">No lyrics saved.</p>
    <% } else { %>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% lyrics.forEach(lyric => { %>
            <tr>
              <td><a href="/lyrics/<%= lyric._id %>"><%= lyric.title %></a></td>
              <td><%= lyric.description.length > 100 ? lyric.description.substring(0, 100) + '...' : lyric.description %></td>
              <td>
                <a href="/lyrics/<%= lyric._id %>/edit" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i> Edit</a>
                <form action="/lyrics/<%= lyric._id %>/delete" method="POST" style="display: inline;">
                  <input type="hidden" name="_method" value="DELETE">
                  <button type="submit" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<%- include('../foot'); -%>